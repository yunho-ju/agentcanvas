{
  "schema_version": "agent.spec/v1",
  "id": "clinical-assistant",
  "version": 3,
  "revision": "sha256:2247ea51e0f3c52fee8679b0f817f08580960e935af9a8011c5f1e6a7a81431a",
  "status": "draft",
  "input_schema": {
    "type": "object",
    "properties": {
      "question": { "type": "string" },
      "patient_context": { "type": "object" }
    },
    "required": ["question"]
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "route": { "type": "string" },
      "messages": { "type": "array" },
      "evidence": { "type": "array" },
      "answer": { "type": "string" },
      "approval": { "type": "object" }
    }
  },
  "resources": [
    {
      "id": "clinical-reference",
      "kind": "mcp.toolset",
      "server_ref": "mcp://clinical-reference",
      "allowed_tools": ["search_article", "get_article"],
      "tools": [
        {
          "name": "search_article",
          "plain_description": {
            "ko": "물어본 것과 관련 있는 진료 지침 글을 찾아 목록으로 돌려준다.",
            "en": "Finds care guideline articles about what you asked and lists them."
          },
          "input_schema": {
            "type": "object",
            "properties": {
              "query": { "type": "string", "title": "What to look for" }
            },
            "required": ["query"]
          },
          "output_schema": {
            "type": "object",
            "properties": {
              "articles": { "type": "array", "title": "Articles that were found" }
            }
          },
          "timeout_ms": 8000,
          "call": { "transport": "mcp", "remote_name": "search_article" }
        },
        {
          "name": "get_article",
          "plain_description": {
            "ko": "고른 글 하나의 본문을 통째로 가져온다.",
            "en": "Brings back the whole text of one article you picked."
          },
          "input_schema": {
            "type": "object",
            "properties": {
              "article_id": { "type": "string", "title": "Which article" }
            },
            "required": ["article_id"]
          },
          "output_schema": {
            "type": "object",
            "properties": {
              "title": { "type": "string", "title": "Title of the article" },
              "body": { "type": "string", "title": "Text of the article" }
            }
          },
          "timeout_ms": 8000,
          "call": { "transport": "mcp", "remote_name": "get_article" }
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "input",
      "type": "core.input",
      "position": { "x": 80, "y": 240 },
      "config": {
        "bindings": {
          "question": "input.question",
          "patient_context": "input.patient_context"
        }
      }
    },
    {
      "id": "triage",
      "type": "llm.router",
      "position": { "x": 360, "y": 240 },
      "config": {
        "model_ref": "model://default",
        "prompt_ref": "prompt://triage@2",
        "output_schema_ref": "schema://triage-result@1"
      }
    },
    {
      "id": "clinical-agent",
      "type": "llm.agent",
      "position": { "x": 700, "y": 240 },
      "config": {
        "model_ref": "model://default",
        "prompt_ref": "prompt://clinical@7",
        "toolset_refs": ["clinical-reference"],
        "max_turns": 4
      }
    },
    {
      "id": "human-gate",
      "type": "control.human_gate",
      "position": { "x": 1040, "y": 240 },
      "config": {
        "approval_schema_ref": "schema://answer-review@1"
      }
    },
    {
      "id": "output",
      "type": "core.output",
      "position": { "x": 1320, "y": 240 },
      "config": { "binding": "state.answer" }
    }
  ],
  "edges": [
    {
      "id": "input-triage",
      "kind": "data",
      "source": { "node": "input", "port": "question" },
      "target": { "node": "triage", "port": "input" }
    },
    {
      "id": "triage-agent",
      "kind": "control",
      "source": { "node": "triage", "port": "passthrough" },
      "target": { "node": "clinical-agent", "port": "messages" },
      "condition": {
        "language": "cel",
        "expression": "route == 'clinical'"
      }
    },
    {
      "id": "agent-human",
      "kind": "approval",
      "source": { "node": "clinical-agent", "port": "response" },
      "target": { "node": "human-gate", "port": "review" }
    },
    {
      "id": "human-output",
      "kind": "control",
      "source": { "node": "human-gate", "port": "approved" },
      "target": { "node": "output", "port": "input" }
    }
  ],
  "execution": {
    "checkpointer": "postgres",
    "replay_policy": "recorded_tools_first",
    "limits": {
      "max_total_tokens": 20000,
      "max_runtime_ms": 120000,
      "max_tool_calls": 12
    }
  }
}
