{
  "$defs": {
    "AddEdgeOperation": {
      "additionalProperties": false,
      "properties": {
        "edge": {
          "$ref": "#/$defs/Edge"
        },
        "op": {
          "const": "add_edge",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "edge"
      ],
      "title": "AddEdgeOperation",
      "type": "object"
    },
    "AddNodeOperation": {
      "additionalProperties": false,
      "properties": {
        "node": {
          "$ref": "#/$defs/Node"
        },
        "op": {
          "const": "add_node",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "node"
      ],
      "title": "AddNodeOperation",
      "type": "object"
    },
    "AddResourceOperation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "add_resource",
          "title": "Op",
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/ResourceBinding"
        }
      },
      "required": [
        "op",
        "resource"
      ],
      "title": "AddResourceOperation",
      "type": "object"
    },
    "AddSkillOperation": {
      "additionalProperties": false,
      "description": "문서가 따를 skill 한 장을 들인다 — 본문은 카탈로그의 원문 그대로다.\n\n모델이 본문을 지어내는 자리가 아니다: 서버가 고른 카탈로그의 SkillDef를 그대로 싣는다\n(제안이 skill을 고르면 그 skill이 함께 들어와야 단계가 없는 것을 입지 않는다).",
      "properties": {
        "op": {
          "const": "add_skill",
          "title": "Op",
          "type": "string"
        },
        "skill": {
          "$ref": "#/$defs/SkillDef"
        }
      },
      "required": [
        "op",
        "skill"
      ],
      "title": "AddSkillOperation",
      "type": "object"
    },
    "ApprovalPolicy": {
      "description": "연결이 도구를 부르기 전에 사람에게 물어보는가.\n\n값은 둘뿐이다: 바로 부르거나(read_only_auto, 기본), 부를 때마다 사람의 확인을\n기다린다(ask_first). \"무엇을 쓸 수 있나\"는 allowed_tools가 이미 정하므로,\n\"부르지 마라\" 같은 세 번째 값은 두지 않는다.",
      "enum": [
        "read_only_auto",
        "ask_first"
      ],
      "title": "ApprovalPolicy",
      "type": "string"
    },
    "ChunkRule": {
      "additionalProperties": false,
      "description": "긴 글을 어떤 단위로 얼마씩 자를지.",
      "properties": {
        "by": {
          "enum": [
            "section",
            "chars"
          ],
          "title": "By",
          "type": "string"
        },
        "size": {
          "exclusiveMinimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "by",
        "size"
      ],
      "title": "ChunkRule",
      "type": "object"
    },
    "DigestResult": {
      "additionalProperties": false,
      "description": "받은 전체를 모델로 줄여 싣는다 — 요약 모델은 본 실행과 분리한다.",
      "properties": {
        "max_chars": {
          "exclusiveMinimum": 0,
          "title": "Max Chars",
          "type": "integer"
        },
        "mode": {
          "const": "digest",
          "title": "Mode",
          "type": "string"
        },
        "model_ref": {
          "pattern": "^model://[A-Za-z0-9._-]+(?:@[A-Za-z0-9._-]+)?$",
          "title": "Model Ref",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "model_ref",
        "max_chars"
      ],
      "title": "DigestResult",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EdgeKind"
        },
        "source": {
          "$ref": "#/$defs/EdgeEndpoint"
        },
        "target": {
          "$ref": "#/$defs/EdgeEndpoint"
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "target"
      ],
      "title": "Edge",
      "type": "object"
    },
    "EdgeCondition": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "language": {
          "const": "cel",
          "title": "Language",
          "type": "string"
        }
      },
      "required": [
        "language",
        "expression"
      ],
      "title": "EdgeCondition",
      "type": "object"
    },
    "EdgeEndpoint": {
      "additionalProperties": false,
      "properties": {
        "node": {
          "minLength": 1,
          "title": "Node",
          "type": "string"
        },
        "port": {
          "minLength": 1,
          "title": "Port",
          "type": "string"
        }
      },
      "required": [
        "node",
        "port"
      ],
      "title": "EdgeEndpoint",
      "type": "object"
    },
    "EdgeKind": {
      "enum": [
        "data",
        "control",
        "approval"
      ],
      "title": "EdgeKind",
      "type": "string"
    },
    "FullResult": {
      "additionalProperties": false,
      "description": "받은 것을 그대로 싣는다 — 작은 응답의 기본값.",
      "properties": {
        "mode": {
          "const": "full",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "FullResult",
      "type": "object"
    },
    "HttpCall": {
      "additionalProperties": false,
      "description": "우리가 감싼 HTTP API를 부르는 방법.",
      "properties": {
        "auth": {
          "anyOf": [
            {
              "pattern": "^secret://[A-Za-z0-9._-]+(?:@[A-Za-z0-9._-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auth"
        },
        "method": {
          "$ref": "#/$defs/HttpMethod"
        },
        "transport": {
          "const": "http",
          "title": "Transport",
          "type": "string"
        },
        "url_template": {
          "minLength": 1,
          "title": "Url Template",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "method",
        "url_template"
      ],
      "title": "HttpCall",
      "type": "object"
    },
    "HttpMethod": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "title": "HttpMethod",
      "type": "string"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "description": "화면에 그대로 나가는 한 조각의 글. 한 언어만 채운 글은 계약이 아니다.",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "ko": {
          "minLength": 1,
          "title": "Ko",
          "type": "string"
        }
      },
      "required": [
        "ko",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "McpCall": {
      "additionalProperties": false,
      "description": "MCP 서버가 아는 이름으로 도구를 부르는 방법.",
      "properties": {
        "remote_name": {
          "minLength": 1,
          "title": "Remote Name",
          "type": "string"
        },
        "transport": {
          "const": "mcp",
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "remote_name"
      ],
      "title": "McpCall",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "position"
      ],
      "title": "Node",
      "type": "object"
    },
    "PatchOperation": {
      "discriminator": {
        "mapping": {
          "add_edge": "#/$defs/AddEdgeOperation",
          "add_node": "#/$defs/AddNodeOperation",
          "add_resource": "#/$defs/AddResourceOperation",
          "add_skill": "#/$defs/AddSkillOperation",
          "remove_edge": "#/$defs/RemoveEdgeOperation",
          "remove_node": "#/$defs/RemoveNodeOperation",
          "remove_resource": "#/$defs/RemoveResourceOperation",
          "replace_node_config": "#/$defs/ReplaceNodeConfigOperation",
          "replace_resource": "#/$defs/ReplaceResourceOperation"
        },
        "propertyName": "op"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AddNodeOperation"
        },
        {
          "$ref": "#/$defs/RemoveNodeOperation"
        },
        {
          "$ref": "#/$defs/ReplaceNodeConfigOperation"
        },
        {
          "$ref": "#/$defs/AddEdgeOperation"
        },
        {
          "$ref": "#/$defs/RemoveEdgeOperation"
        },
        {
          "$ref": "#/$defs/AddResourceOperation"
        },
        {
          "$ref": "#/$defs/ReplaceResourceOperation"
        },
        {
          "$ref": "#/$defs/RemoveResourceOperation"
        },
        {
          "$ref": "#/$defs/AddSkillOperation"
        }
      ]
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
    },
    "RemoveEdgeOperation": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "op": {
          "const": "remove_edge",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "edge_id"
      ],
      "title": "RemoveEdgeOperation",
      "type": "object"
    },
    "RemoveNodeOperation": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "op": {
          "const": "remove_node",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "node_id"
      ],
      "title": "RemoveNodeOperation",
      "type": "object"
    },
    "RemoveResourceOperation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "remove_resource",
          "title": "Op",
          "type": "string"
        },
        "resource_id": {
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "op",
        "resource_id"
      ],
      "title": "RemoveResourceOperation",
      "type": "object"
    },
    "ReplaceNodeConfigOperation": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "op": {
          "const": "replace_node_config",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "node_id",
        "config"
      ],
      "title": "ReplaceNodeConfigOperation",
      "type": "object"
    },
    "ReplaceResourceOperation": {
      "additionalProperties": false,
      "description": "같은 id의 바인딩을 통째로 갈아 끼운다 — 도구 목록까지 새 것이 된다.",
      "properties": {
        "op": {
          "const": "replace_resource",
          "title": "Op",
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/ResourceBinding"
        }
      },
      "required": [
        "op",
        "resource"
      ],
      "title": "ReplaceResourceOperation",
      "type": "object"
    },
    "ResourceBinding": {
      "additionalProperties": false,
      "properties": {
        "allowed_tools": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Tools",
          "type": "array"
        },
        "approval_policy": {
          "$ref": "#/$defs/ApprovalPolicy",
          "default": "read_only_auto"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "server_ref": {
          "pattern": "^(?:mcp|api)://[A-Za-z0-9._-]+(?:@[A-Za-z0-9._-]+)?$",
          "title": "Server Ref",
          "type": "string"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolDef"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "server_ref"
      ],
      "title": "ResourceBinding",
      "type": "object"
    },
    "RetrieveResult": {
      "additionalProperties": false,
      "description": "질의로 관련 조각만 골라 싣는다.",
      "properties": {
        "chunk": {
          "$ref": "#/$defs/ChunkRule"
        },
        "mode": {
          "const": "retrieve",
          "title": "Mode",
          "type": "string"
        },
        "query_param": {
          "minLength": 1,
          "title": "Query Param",
          "type": "string"
        },
        "top_k": {
          "exclusiveMinimum": 0,
          "title": "Top K",
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "query_param",
        "top_k",
        "chunk"
      ],
      "title": "RetrieveResult",
      "type": "object"
    },
    "SectionsResult": {
      "additionalProperties": false,
      "description": "부르는 쪽이 필요한 섹션만 골라 받는다.",
      "properties": {
        "mode": {
          "const": "sections",
          "title": "Mode",
          "type": "string"
        },
        "section_param": {
          "minLength": 1,
          "title": "Section Param",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "section_param"
      ],
      "title": "SectionsResult",
      "type": "object"
    },
    "SkillDef": {
      "additionalProperties": false,
      "description": "표준 SKILL.md 하나 — 노드는 `skill_refs`에 이 `ref`를 적어 입는다.",
      "properties": {
        "body": {
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "compatibility": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compatibility"
        },
        "description": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "ref": {
          "pattern": "^skill://[A-Za-z0-9._-]+(?:@[A-Za-z0-9._-]+)?$",
          "title": "Ref",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/SkillReference"
          },
          "title": "References",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "ref",
        "name",
        "description",
        "body"
      ],
      "title": "SkillDef",
      "type": "object"
    },
    "SkillReference": {
      "additionalProperties": false,
      "description": "skill 곁의 읽을 문서 하나 — 점진 공개의 셋째 단계에서 사람이 펼쳐 본다.",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "path",
        "text"
      ],
      "title": "SkillReference",
      "type": "object"
    },
    "SkillSource": {
      "additionalProperties": false,
      "description": "이 skill이 어디서 왔는가 — 나중에 새 판이 나왔는지 확인하는 데 쓴다.",
      "properties": {
        "fetched_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fetched At"
        },
        "fetched_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fetched Revision"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "SkillSource",
      "type": "object"
    },
    "ToolDef": {
      "additionalProperties": false,
      "description": "바인딩 하나가 들고 다니는 도구 한 개.",
      "properties": {
        "call": {
          "discriminator": {
            "mapping": {
              "http": "#/$defs/HttpCall",
              "mcp": "#/$defs/McpCall"
            },
            "propertyName": "transport"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/HttpCall"
            },
            {
              "$ref": "#/$defs/McpCall"
            }
          ],
          "title": "Call"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "output_schema": {
          "additionalProperties": true,
          "title": "Output Schema",
          "type": "object"
        },
        "plain_description": {
          "$ref": "#/$defs/LocalizedText"
        },
        "result_handling": {
          "discriminator": {
            "mapping": {
              "digest": "#/$defs/DigestResult",
              "full": "#/$defs/FullResult",
              "retrieve": "#/$defs/RetrieveResult",
              "sections": "#/$defs/SectionsResult"
            },
            "propertyName": "mode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FullResult"
            },
            {
              "$ref": "#/$defs/SectionsResult"
            },
            {
              "$ref": "#/$defs/DigestResult"
            },
            {
              "$ref": "#/$defs/RetrieveResult"
            }
          ],
          "title": "Result Handling"
        },
        "timeout_ms": {
          "exclusiveMinimum": 0,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "plain_description",
        "input_schema",
        "output_schema",
        "timeout_ms",
        "call"
      ],
      "title": "ToolDef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "AgentSpec을 안전하게 바꾸기 위한 순서 있는 작업 목록.",
  "properties": {
    "base_revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Base Revision",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/PatchOperation"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "schema_version": {
      "const": "agent.patch/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "base_revision",
    "operations"
  ],
  "title": "AgentSpecPatch",
  "type": "object"
}
