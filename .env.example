# Compose가 외부에 공개할 주소와 포트. 기본은 이 컴퓨터에서만 접근 가능하다.
AGENTCANVAS_BIND=127.0.0.1
AGENTCANVAS_PORT=8080

# API를 별도 origin으로 공개할 때만 정확한 origin을 쉼표로 나열한다. "*"는 쓰지 않는다.
AGENTCANVAS_ALLOWED_ORIGINS=http://localhost:8080

# 필수: self-host 관리자 로그인. 두 값은 서로 다르게 생성하고 실제 값은 .env에만 둔다.
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
AGENTCANVAS_ADMIN_PASSWORD=
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
AGENTCANVAS_SESSION_SECRET=
AGENTCANVAS_SESSION_TTL_SECONDS=28800
# localhost HTTP는 false. TLS로 공개할 때는 반드시 true.
AGENTCANVAS_COOKIE_SECURE=false

# 컨테이너 내부 SQLite 경로. WAL/SHM을 함께 보존하도록 /data volume에 둔다.
AGENTCANVAS_DB=/data/agentcanvas.db
# schema migration 전 backup은 별도 /backups volume에 저장되며 최신 N개를 보존한다.
AGENTCANVAS_BACKUP_RETENTION=10

# Studio bundle에 build 시 삽입된다. Compose의 same-origin proxy는 /api를 사용한다.
VITE_API_URL=/api

# 선택: OpenAI-backed Guided/실행. key와 실제 계정에서 사용할 수 있는 model ID를 함께 명시한다.
# 예: AGENTCANVAS_OPENAI_MODEL=<your-openai-model-id>
AGENTCANVAS_OPENAI_MODEL=
AGENTCANVAS_SECRET_OPENAI_API_KEY=

# 선택: Anthropic 모델 catalog와 실행용 secret. Guided 초안은 현재 OpenAI 설정이 필요하다.
AGENTCANVAS_SECRET_ANTHROPIC_API_KEY=

# 선택: OpenAI-compatible local model. 컨테이너에서 호스트 모델에 접근하는 주소다.
AGENTCANVAS_LOCAL_MODEL=
AGENTCANVAS_LOCAL_BASE_URL=http://host.docker.internal:11434/v1

# 선택: eval 심판이 부를 모델 이름. 비우면 기본(model://default)이고,
# 이 서버에서 열 수 없는 이름이면 심판 층은 서지 않는다.
AGENTCANVAS_JUDGE_MODEL=
